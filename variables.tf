variable "kubeconfig_path" {
  description = "Path to the Talos cluster's kubeconfig, generated by the proxmox-tofu / talosctl bootstrap."
  type        = string
  default     = "../proxmox-tofu/_out/kubeconfig"
}

variable "oidc_username_prefix" {
  description = "Prefix the apiserver applies to OIDC usernames (--oidc-username-prefix in the Talos apiServer patch, see proxmox-tofu/talos-oidc-patch.yaml). Must match exactly or RBAC subjects won't resolve."
  type        = string
  default     = "oidc:"
}

variable "users" {
  description = <<-EOT
    Cluster users, identified by the OIDC preferred_username claim Authentik
    issues for them (their Authentik username). role selects the built-in
    ClusterRole they're bound to: "admin", "edit", or "view".
  EOT
  type = list(object({
    username = string
    role     = string
  }))
  default = []

  validation {
    condition     = alltrue([for u in var.users : contains(["admin", "edit", "view"], u.role)])
    error_message = "role must be one of: admin, edit, view."
  }
}
